# Amilon API credentials.
#
# This file is committed and contains PLACEHOLDER values only.
# Put the real credentials in .env.local (git-ignored) — it overrides every
# value below without being tracked.
#
# STAGING and PRODUCTION use different hosts: keep the trailing slash on the
# two *_DOMAIN URLs, the HTTP layer relies on it.

AMILON_USERNAME=your-username
AMILON_PASSWORD=your-password
AMILON_CLIENT_ID=your-client-id
AMILON_CLIENT_SECRET=your-client-secret
AMILON_AUTH_DOMAIN=https://b2bstg-sso.amilon.eu/
AMILON_WEB_DOMAIN=https://b2bstg-webapi.amilon.eu/b2bwebapi/v1/
AMILON_CONTRACT_ID=00000000-0000-0000-0000-000000000000
AMILON_RUN_ORDER_TESTS=0
AMILON_KNOWN_ORDER_ID=amilon-lib-it-b060bd63a2f4630c